# AI rule parser configuration. Server-side only: never prefix these with VITE_
# (that would ship them to the browser). Copy to .env and fill in ONE provider.

# Which provider parses natural-language rules: groq | anthropic
# Required to use Groq. If unset, "anthropic" is used (the original default);
# the app never switches provider on its own.
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b. Strict JSON-schema output is used for
# openai/gpt-oss-120b and openai/gpt-oss-20b; other models use JSON mode.
# GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (only needed when LLM_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# Optional. Default: claude-opus-5-5. LLM_MODEL is accepted as a legacy alias.
# ANTHROPIC_MODEL=claude-opus-5-5
